# === Serveur ===
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# === Base de données PostgreSQL (Sequelize) ===
# EN PRODUCTION / RENDER : renseignez UNIQUEMENT DATABASE_URL (fournie par Render,
# "Internal Database URL"). Le SSL est activé automatiquement dans ce cas.
DATABASE_URL=
#
# EN LOCAL (Postgres installé sur votre machine) : laissez DATABASE_URL vide et
# renseignez les variables ci-dessous. Port Postgres par défaut = 5432.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cheikh_tidiane_apple
DB_USER=postgres
DB_PASSWORD=
# DB_SSL=true   # forcer le SSL en local si votre Postgres l'exige (rare)

# === Authentification (JWT) ===
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# === Connexion Google (Google Identity Services) ===
# Créez un ID client OAuth 2.0 (type « Web ») sur https://console.cloud.google.com
# et renseignez le MÊME identifiant côté frontend (VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=

# === Cloudinary (stockage images) ===
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# === Email (Nodemailer) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Cheikh Tidiane Apple <no-reply@example.com>"

# === Paiement ===
# URL publique de cette API (pour construire les URL de webhook).
APP_URL=http://localhost:5000

# Wave (Wave Checkout API) — laissez vide pour activer le mode simulation.
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
# WAVE_API_BASE=https://api.wave.com/v1

# Orange Money (Web Payment) — laissez vide pour le mode simulation.
OM_CLIENT_ID=
OM_CLIENT_SECRET=
OM_MERCHANT_KEY=
# OM_API_BASE=https://api.orange.com/orange-money-webpay/dev/v1
# OM_CURRENCY=OUV   # 'OUV' en sandbox, 'XOF' en production
